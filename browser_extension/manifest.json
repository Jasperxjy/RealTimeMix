{
  "manifest_version": 3,
  "name": "RealTimeMix Lens",
  "version": "1.0.0",
  "description": "Auto-align decrypt lens for RealTimeMix",
  "permissions": ["nativeMessaging", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
